{
  "manifest_version": 3,
  "name": "OX-Alpha",
  "version": "1.0.0",
  "description": "أرسل أي نص أو كود أو صفحة إلى OX-Alpha Workbench، واسأل الذكاء الاصطناعي من أي موقع.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OX-Alpha"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://daschai.vercel.app/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      }
    }
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon.svg"
  }
}
