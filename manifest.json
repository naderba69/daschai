  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [
          ".txt",
          ".md",
          ".log",
          ".csv"
        ],
        "text/javascript": [
          ".js",
          ".mjs",
          ".jsx",
          ".ts",
          ".tsx"
        ],
        "application/json": [
          ".json"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/css": [
          ".css"
        ],
        "text/x-python": [
          ".py"
        ],
        "application/zip": [
          ".zip"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 420
  },
  "widgets": [
    {
      "name": "OX-Alpha — نظرة سريعة",
      "short_name": "OX-Alpha",
      "description": "عدد المحادثات والمهام ورسائل اليوم",
      "tag": "ox-quick",
      "template": "ox-quick",
      "ms_ac_template": "/widgets/quick.json",
      "data": "/widgets/data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512",
          "label": "OX-Alpha widget"
        }
      ]
    }
  ]
