{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "✦ ${title}", "weight": "Bolder", "size": "Medium" },
    { "type": "ColumnSet", "columns": [
      { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${sessions}", "size": "ExtraLarge", "weight": "Bolder" }, { "type": "TextBlock", "text": "محادثة", "isSubtle": true, "spacing": "None" } ] },
      { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${tasks}", "size": "ExtraLarge", "weight": "Bolder" }, { "type": "TextBlock", "text": "مهمة مفتوحة", "isSubtle": true, "spacing": "None" } ] },
      { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${today}", "size": "ExtraLarge", "weight": "Bolder" }, { "type": "TextBlock", "text": "رسالة اليوم", "isSubtle": true, "spacing": "None" } ] }
    ] },
    { "type": "TextBlock", "text": "آخر محادثة: ${last}", "wrap": true, "maxLines": 2, "size": "Small" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "محادثة جديدة", "verb": "new" },
    { "type": "Action.Execute", "title": "المهام", "verb": "tasks" }
  ]
}
