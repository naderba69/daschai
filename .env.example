# ==============================================================================
# OX-Alpha Workbench Pro - Environment Configuration
# ==============================================================================

# OpenRouter API Key (Required for AI model completions and streaming)
# Obtain your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default AI Model to load on start
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4o, openai/gpt-4o-mini,
#          deepseek/deepseek-chat, deepseek/deepseek-r1, google/gemini-2.0-flash-001,
#          meta-llama/llama-3.3-70b-instruct, mistralai/mistral-large-2411, qwen/qwen-2.5-coder-32b-instruct
NEXT_PUBLIC_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# GitHub Personal Access Token (PAT) for Autonomous Repository Tools
# Generate token at https://github.com/settings/tokens (Needs 'repo' scope)
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target Repository Configuration for Autonomous Agent
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name
GITHUB_DEFAULT_BRANCH=main

# Daily API Quota & Usage Thresholds (for warning notifications)
DAILY_REQUEST_LIMIT=100
DAILY_TOKEN_LIMIT=100000

# Next.js Application URL
NEXT_PUBLIC_APP_URL=https://ox-alpha-workbench-pro.vercel.app
